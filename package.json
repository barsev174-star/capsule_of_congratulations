{
  "name": "capsule-of-congratulations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && next dev",
    "build": "next build",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "brand:check": "node scripts/check-brand-layouts.mjs",
    "share:og-assets": "node scripts/build-public-share-og-assets.mjs",
    "route:assets": "node scripts/optimize-route-assets.mjs",
    "route:check": "node scripts/check-route-assets.mjs",
    "landing:caregiver-assets": "node scripts/build-caregiver-landing-assets.mjs",
    "template:legacy-assets": "node scripts/check-legacy-template-assets.mjs",
    "template:legacy-baseline": "node scripts/check-legacy-template-baseline.mjs",
    "template:universal-baseline": "node scripts/check-universal-template-baseline.mjs",
    "template:new": "node scripts/template-new.mjs",
    "template:assets": "node scripts/optimize-template-assets.mjs",
    "template:check": "node scripts/check-template-assets.mjs",
    "template:ci": "npm run template:check && npm run template:legacy-assets && npm run template:legacy-baseline && npm run template:universal-baseline",
    "template:launch-check": "npm run template:ci && npm test && npm run build",
    "template:northern-light:source": "node scripts/build-northern-light-source-assets.mjs",
    "template:daylight-proof:source": "node scripts/build-daylight-proof-source-assets.mjs",
    "template:school-scrapbook:source": "node scripts/build-school-scrapbook-source-assets.mjs",
    "template:school-classic:source": "node scripts/build-school-classic-source-assets.mjs",
    "template:kindergarten-doodles:source": "node scripts/build-kindergarten-doodles-source-assets.mjs",
    "template:team-editorial:source": "node scripts/build-team-editorial-source-assets.mjs",
    "start": "next start",
    "lint": "eslint . && npm run ui:colors && npm run ui:contrast",
    "ui:colors": "node scripts/check-ui-colors.mjs",
    "ui:contrast": "node scripts/check-preview-contrast.mjs",
    "preflight": "npm run lint && npm test && npm run build && npm run smoke:local && npm run smoke:admin && npm run smoke:retention",
    "smoke:local": "node --env-file=.env.local scripts/smoke-local.mjs",
    "smoke:admin": "node --env-file=.env.local scripts/smoke-admin-local.mjs",
    "smoke:retention": "node --env-file=.env.local scripts/smoke-retention-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "cleanup:prelaunch": "node --experimental-strip-types scripts/cleanup-prelaunch-user-data.ts",
    "ai:check": "node --env-file=.env.local scripts/check-gigachat.mjs",
    "test": "vitest run",
    "test:greetings:matrix": "vitest run src/lib/ai/openai-provider.live.test.ts --reporter=verbose",
    "test:greetings:levels": "vitest run src/lib/ai/openai-assistance-levels.live.test.ts --reporter=verbose",
    "test:greetings:semantic-corpus": "vitest run src/lib/ai/greeting-semantic-fixtures.test.ts --reporter=verbose",
    "test:greetings:semantic-live": "vitest run src/lib/ai/greeting-semantic-evaluation.live.test.ts --reporter=verbose",
    "test:reminders:email:live": "node --env-file=.env.local scripts/run-reminder-email-live.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^16.3.3",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^27.2.0",
    "playwright-core": "^1.61.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
