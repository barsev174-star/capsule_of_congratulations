# Local development keeps using JSON files when DATABASE_URL is empty.
# Set DATABASE_URL to switch cards, contributions, and media metadata to PostgreSQL.
DATABASE_URL=

# Public base URL for generated participant/manage/preview/gift links.
NEXT_PUBLIC_SITE_URL=https://slovesto.ru
PUBLIC_SHARE_TOKEN_SECRET=
# Per-process protection for the current single-web-instance production setup.
PUBLIC_CARD_CREATE_RATE_LIMIT=12
PUBLIC_CONTRIBUTION_RATE_LIMIT=40
PUBLIC_AI_RATE_LIMIT=24
PUBLIC_TELEMETRY_RATE_LIMIT=240

# Passwordless organizer account and email delivery.
ORGANIZER_SESSION_SECRET=
# Direct Yandex Cloud Postbox delivery.
EMAIL_PROVIDER=
YANDEX_POSTBOX_ACCESS_KEY_ID=
YANDEX_POSTBOX_SECRET_ACCESS_KEY=
YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
YANDEX_POSTBOX_REGION=ru-central1
CRON_SECRET=
REMINDER_TIME_ZONE=Asia/Yekaterinburg
REMINDER_TOKEN_SECRET=
EMAIL_FROM=Дари слова <hello@example.com>
# New support requests are always emailed here.
SUPPORT_NOTIFICATION_EMAIL=support@slovesto.ru

# Production example:
# DATABASE_URL=postgres://capsule:change-me@localhost:5432/capsule

# User photos are stored locally in public/uploads/cards for the first VPS release.
# Back up that directory together with PostgreSQL.

# Admin panel credentials.
# Generate ADMIN_PASSWORD_HASH and ADMIN_PASSWORD_SALT with:
#   node scripts/generate-admin-password.mjs
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=
ADMIN_SESSION_SECRET=

# AI greeting helper. Keep all provider keys server-side only.
AI_PROVIDER=mock
AI_GREETING_PROVIDER=
AI_INSIGHTS_PROVIDER=
AI_FREE_LIMIT=5
AI_PAID_LIMIT=30
# Direct Yandex AI Studio.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
YANDEX_CLOUD_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_CLOUD_AI_TIMEOUT_MS=60000
YANDEX_COMPOSER_PLANNING=1
# Direct Yandex aliases are resolved to explicit versioned gpt:// URIs.
YANDEX_GREETING_EXTRACTOR_MODEL=yandex/gpt-pro-5.1
YANDEX_GREETING_COMPOSER_MODEL=yandex/gpt-pro-5.1
YANDEX_GREETING_EDIT_MODEL=yandex/gpt-pro-5.1
YANDEX_INSIGHTS_MODEL=yandex/gpt-pro-5.1
